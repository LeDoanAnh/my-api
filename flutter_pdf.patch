+      ScaffoldMessenger.of(context).showSnackBar(
+        const SnackBar(content: Text('Không thể mở bản PDF của tờ trình.')),
+      );
+    } finally {
+      if (mounted) setState(() => _isOpeningPdf = false);
+    }
+  }
